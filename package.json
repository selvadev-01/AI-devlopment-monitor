{
  "name": "ai-development-monitor",
  "version": "0.2.4",
  "private": true,
  "description": "Live 3D visualization of what Claude Code is doing in your project (Neural + Galaxy themes).",
  "type": "module",
  "bin": {
    "adm": "bin/adm.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "adm": "node bin/adm.js",
    "test": "node --test \"test/*.test.js\"",
    "demo": "node scripts/simulate.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "ext:build": "node scripts/build-extension.js",
    "ext:install": "node scripts/build-extension.js --install"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "8.18.0"
  }
}
