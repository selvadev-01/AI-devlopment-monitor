{
  "name": "ai-dev-monitor",
  "displayName": "AI Dev Monitor",
  "description": "See what Claude Code is doing, live: a 3D view (Neural or Galaxy) of your project with every file Claude reads, edits and tests, its subagents, needs-you alerts, session summaries and token cost.",
  "version": "0.2.6",
  "publisher": "selvadev",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b0f16",
    "theme": "dark"
  },
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai",
    "agent",
    "subagents",
    "visualization",
    "3d",
    "monitor",
    "hooks",
    "token usage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/selvadev-01/AI-devlopment-monitor.git"
  },
  "homepage": "https://github.com/selvadev-01/AI-devlopment-monitor#readme",
  "bugs": {
    "url": "https://github.com/selvadev-01/AI-devlopment-monitor/issues"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiDevMonitor.open",
        "title": "Open Monitor",
        "category": "AI Dev Monitor",
        "icon": "$(pulse)"
      },
      {
        "command": "aiDevMonitor.showWorkspace",
        "title": "Show This Workspace",
        "category": "AI Dev Monitor"
      },
      {
        "command": "aiDevMonitor.openInBrowser",
        "title": "Open in Browser",
        "category": "AI Dev Monitor"
      },
      {
        "command": "aiDevMonitor.installHooks",
        "title": "Install Claude Code Hooks",
        "category": "AI Dev Monitor"
      },
      {
        "command": "aiDevMonitor.removeHooks",
        "title": "Remove Claude Code Hooks",
        "category": "AI Dev Monitor"
      }
    ],
    "configuration": {
      "title": "AI Dev Monitor",
      "properties": {
        "aiDevMonitor.port": {
          "type": "number",
          "default": 7777,
          "description": "Port of the local monitor server. The Claude Code hooks send events to this port."
        },
        "aiDevMonitor.quality": {
          "type": "string",
          "enum": [
            "low",
            "balanced",
            "high"
          ],
          "default": "balanced",
          "enumDescriptions": [
            "Lightest: no anti-aliasing, 30 fps (10 when idle). Best for older laptops or battery.",
            "Anti-aliasing, 60 fps (20 when idle).",
            "Full resolution on high-DPI screens. Needs a good GPU."
          ],
          "description": "Render quality of the 3D view. Reopen the panel after changing it."
        },
        "aiDevMonitor.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the monitor panel automatically when a Claude Code session starts in this window's workspace. The panel opens beside the editor without taking focus."
        },
        "aiDevMonitor.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the monitor server when VS Code starts, so events are captured even while the panel is closed."
        }
      }
    }
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "8.18.0"
  }
}
